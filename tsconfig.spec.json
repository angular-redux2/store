/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "outDir": "./out-tsc/spec",
        "sourceMap": true,
        "removeComments": false,
        "types": [
            "node",
            "@remotex-labs/xjet"
        ]
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "dist",
        "docs",
        "node_modules"
    ]
}
