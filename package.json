{
    "name": "@angular-redux2/store",
    "author": "Garfild (https://github.com/Garefild)",
    "license": "MPL-2.0",
    "version": "1.0.0-local",
    "homepage": "https://angular-redux2.github.io/store/",
    "description": "Angular bindings for Redux",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/angular-redux2/store.git"
    },
    "bugs": {
        "url": "https://github.com/angular-redux2/store/issues"
    },
    "keywords": [
        "angular",
        "redux",
        "rxjs",
        "store",
        "state management"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev":              "ng-packagr -p ng-package.json -c tsconfig.json --watch",
        "build":            "ng-packagr -p ng-package.json -c tsconfig.json",

        "test":             "xjet",
        "test:coverage":    "xjet --coverage",

        "lint":             "pnpm lint:md && pnpm lint:eslint",
        "lint:md":          "markdownlint \"**/*.md\" --ignore node_modules",
        "lint:eslint":      "eslint . -c ./eslint.config.mjs",

        "docs:dev":         "vitepress dev docs",
        "docs:build":       "vitepress build docs",
        "docs:preview":     "vitepress preview docs"
    },
    "dependencies": {
        "tslib": "^2.8.0"
    },
    "devDependencies": {
        "rxjs": "~7.8.0",
        "tslib": "^2.8.0",
        "redux": "^5.0.1",
        "eslint": "^10.15.0",
        "zone.js": "~0.16.0",
        "vitepress": "2.0.0-alpha.21",
        "ng-packagr": "^22.3.0",
        "markdownlint-cli": "^0.50.1",
        "typescript-eslint": "^8.74.0",
        "eslint-plugin-tsdoc": "^0.5.4",
        "eslint-plugin-perfectionist": "^5.13.0",

        "@types/node": "^26.6.11",
        "@angular/core": "^22.3.0",
        "@angular/compiler": "^22.3.0",
        "@viteplus/versions": "^3.0.0",
        "@remotex-labs/xjet": "^1.5.6",
        "@angular/compiler-cli": "^22.3.0"
    },
    "peerDependencies": {
        "rxjs": "^7.5.0",
        "redux": "^5.0.0",
        "@angular/core": ">=20.0.0"
    }
}
